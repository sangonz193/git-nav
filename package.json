{
  "name": "git-nav",
  "version": "0.0.13",
  "private": true,
  "scripts": {
    "build": "bun --filter=desktop run build",
    "bump": "bun scripts/bump.ts",
    "build:package": "bun --filter=git-nav run build:package",
    "bootstrap:platform-packages": "bun --filter=git-nav run bootstrap:platform-packages",
    "dev": "bun --filter=desktop run dev",
    "dev:web": "bun --filter=desktop run dev:web",
    "lint": "bun run --workspaces lint",
    "format": "bun run --workspaces format",
    "test": "bun test scripts/create-update-release.test.ts && bun run --workspaces --if-present test",
    "tauri": "bun --filter=desktop run tauri",
    "typecheck": "tsc -b && tsc -b apps/desktop/tsconfig.node.json",
    "update-ts-references": "update-ts-references --configName tsconfig.app.json",
    "check-ts-references": "update-ts-references --configName tsconfig.app.json --check",
    "postinstall": "bun run update-ts-references"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "update-ts-references": "^6.1.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
