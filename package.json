{
  "name": "git-nav",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun --filter=desktop run build",
    "dev": "bun --filter=desktop run dev",
    "lint": "bun run --workspaces lint",
    "format": "bun run --workspaces format",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
