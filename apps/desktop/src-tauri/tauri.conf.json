{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Git Nav",
  "version": "0.0.5",
  "identifier": "com.gitnav.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Git Nav",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 12,
          "y": 11
        },
        "hiddenTitle": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 Santiago González",
    "homepage": "https://github.com/sangonz193/git-nav",
    "publisher": "Santiago González",
    "shortDescription": "Read Git history, worktrees and diffs",
    "longDescription": "Git Nav opens a repository and every worktree beside it: a commit graph carrying branches, tags, pull request state and uncommitted work, and a diff between any two references.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
