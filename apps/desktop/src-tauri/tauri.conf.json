{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Git Nav",
  "version": "0.0.15",
  "identifier": "com.gitnav.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Git Nav",
        "width": 1280,
        "height": 800,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "rpm", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "Copyright 2026 Santiago González",
    "homepage": "https://github.com/sangonz193/git-nav",
    "publisher": "Santiago González",
    "shortDescription": "Read Git history, worktrees and diffs",
    "longDescription": "Git Nav opens a repository and every worktree beside it: a commit graph carrying branches, tags, pull request state and uncommitted work, and a diff between any two references.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-path.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MTRGM0Y5RkJDOEVBQzUKUldURjZzajcrZk1VNVBjak1tWHFyTDhTZzV5dm5tTHJPM2U2SkZkSHE0UVE5QmNjWGRkSHVFUFgK",
      "endpoints": [
        "https://github.com/sangonz193/git-nav/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
