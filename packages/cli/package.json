{
  "name": "git-nav",
  "version": "0.0.24",
  "description": "A free, open-source Git GUI for macOS, Windows and Linux: commit graphs, diffs, worktrees, staging and branch cleanup.",
  "keywords": [
    "git",
    "git-gui",
    "git-client",
    "git-worktree",
    "git-diff",
    "squash-merge",
    "desktop"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "git-nav": "./bin/git-nav.js"
  },
  "binaryScope": "@git-nav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sangonz193/git-nav.git",
    "directory": "packages/cli"
  },
  "homepage": "https://git-nav.dev",
  "files": [
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@git-nav/darwin-arm64": "0.0.24",
    "@git-nav/darwin-x64": "0.0.24",
    "@git-nav/linux-arm64": "0.0.24",
    "@git-nav/linux-x64": "0.0.24",
    "@git-nav/win32-arm64": "0.0.24",
    "@git-nav/win32-x64": "0.0.24"
  },
  "scripts": {
    "build:package": "bun run --cwd ../../apps/desktop tauri build && bun scripts/package-platform.ts",
    "bootstrap:platform-packages": "bun scripts/bootstrap-platform-packages.ts",
    "lint": "eslint bin",
    "test": "bun test",
    "release": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "eslint": "^10"
  }
}
